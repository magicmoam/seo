{
  "builds": [
    { "src": "api/query.py", "use": "@vercel/python" },
    { "src": "api/history.py", "use": "@vercel/python" },
    { "src": "api/config.py", "use": "@vercel/python" },
    { "src": "api/usage.py", "use": "@vercel/python" },
    { "src": "api/evidence.py", "use": "@vercel/python" },
    { "src": "api/report.py", "use": "@vercel/python" },
    { "src": "api/free_audit.py", "use": "@vercel/python" },
    { "src": "api/analytics.py", "use": "@vercel/python" },
    { "src": "api/tracking.py", "use": "@vercel/python" },
    { "src": "api/cron_audit.py", "use": "@vercel/python" },
    { "src": "api/ga4_connect.py", "use": "@vercel/python" },
    { "src": "api/stripe_billing.py", "use": "@vercel/python" },
    { "src": "api/admin.py", "use": "@vercel/python" },
    { "src": "api/sitemap.py", "use": "@vercel/python" },
    { "src": "api/pages.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/stripe/checkout", "dest": "/api/stripe_billing.py" },
    { "src": "/api/stripe/webhook", "dest": "/api/stripe_billing.py" },
    { "src": "/api/stripe/portal", "dest": "/api/stripe_billing.py" },
    { "src": "/api/admin/(.*)", "dest": "/api/admin.py" },
    { "src": "/api/query", "dest": "/api/query.py" },
    { "src": "/api/report", "dest": "/api/query.py" },
    { "src": "/api/client-report", "dest": "/api/query.py" },
    { "src": "/api/history", "dest": "/api/history.py" },
    { "src": "/api/config/(.*)", "dest": "/api/config.py" },
    { "src": "/api/config", "dest": "/api/config.py" },
    { "src": "/api/usage", "dest": "/api/usage.py" },
    { "src": "/api/evidence/(.*)", "dest": "/api/evidence.py" },
    { "src": "/api/report/(.*)", "dest": "/api/report.py" },
    { "src": "/api/free-audit", "dest": "/api/free_audit.py" },
    { "src": "/api/analytics", "dest": "/api/analytics.py" },
    { "src": "/api/tracking/snapshots", "dest": "/api/tracking.py" },
    { "src": "/api/tracking/snapshot", "dest": "/api/tracking.py" },
    { "src": "/api/tracking", "dest": "/api/tracking.py" },
    { "src": "/api/cron/audit", "dest": "/api/cron_audit.py" },
    { "src": "/api/ga4/connect", "dest": "/api/ga4_connect.py" },
    { "src": "/api/ga4/properties", "dest": "/api/ga4_connect.py" },
    { "src": "/api/ga4/select-property", "dest": "/api/ga4_connect.py" },
    { "src": "/api/ga4/disconnect", "dest": "/api/ga4_connect.py" },
    { "src": "/api/ga4/status", "dest": "/api/ga4_connect.py" },
    { "src": "/sitemap\\.xml", "dest": "/api/sitemap.py" },
    { "src": "/feed\\.xml", "dest": "/api/pages.py" },
    { "src": "/tools/(.*)", "dest": "/api/pages.py" },
    { "src": "/blog/(.*)", "dest": "/api/pages.py" },
    { "src": "/blog", "dest": "/api/pages.py" },
    { "src": "/metrics", "dest": "/api/pages.py" },
    { "src": "/api/public-metrics", "dest": "/api/pages.py" },
    { "src": "/features", "dest": "/public/features/index.html" },
    { "src": "/pricing", "dest": "/public/pricing/index.html" },
    { "src": "/about", "dest": "/public/about/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "crons": [
    {
      "path": "/api/cron/audit",
      "schedule": "0 6 * * 1"
    }
  ]
}
